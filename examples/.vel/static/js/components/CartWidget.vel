<!-- CartWidget.vel -->
<template>
    <div class="cart-widget">
        <div class="cart-header">
            <h3>🛒 Cart</h3>
            <span class="cart-badge">{{ cartCount }}</span>
        </div>

        <div :show="cartCount === 0" class="cart-empty">
            <span class="emoji">🛒</span>
            <p>Your cart is empty</p>
        </div>

        <div :show="cartCount > 0" class="cart-items">
            <div v-for="item in items" :key="item.id" class="cart-item">
                <span class="cart-item-name">{{ item.name }}</span>
                <span class="cart-item-price">${{ item.price | currency }}</span>
                <button class="cart-item-remove" @click="removeItem(item.id)">✕</button>
            </div>
        </div>

        <div :show="cartCount > 0" class="cart-footer">
            <div class="cart-total">
                <span>Total</span>
                <span>${{ total | currency }}</span>
            </div>
            <div class="cart-actions">
                <button class="btn btn-danger" @click="clearCart">
                    Clear Cart
                </button>
                <button class="btn btn-success" @click="checkout">
                    Checkout
                </button>
            </div>
        </div>
    </div>
</template>

<script>
export default {
    name: 'CartWidget',
    props: {
        items: {
            type: Array,
            default: function() { return []; }
        }
    },
    emits: ['remove-item', 'clear-cart', 'checkout'],
    computed: {
        cartCount: function() {
            return this.items.length;
        },
        total: function() {
            var sum = 0;
            for (var i = 0; i < this.items.length; i++) {
                sum += this.items[i].price;
            }
            return sum;
        }
    },
    methods: {
        removeItem: function(id) {
            this.$emit('remove-item', id);
        },
        clearCart: function() {
            this.$emit('clear-cart');
        },
        checkout: function() {
            this.$emit('checkout');
        }
    }
};
</script>

<style scoped>
