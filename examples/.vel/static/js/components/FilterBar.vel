<!-- FilterBar.vel -->
<template>
    <div class="filter-bar">
        <input
            type="text"
            :model="search"
            @input="applyFilters"
            placeholder="🔍 Search products..."
            class="search-input"
        />

        <select :model="category" @change="applyFilters">
            <option value="">All Categories</option>
            <for key="cat" item="cat" in="categories">
                <option :value="cat">{{ cat }}</option>
            </for>
        </select>

        <input
            type="number"
            :model="minPrice"
            @input="applyFilters"
            placeholder="Min $"
        />

        <input
            type="number"
            :model="maxPrice"
            @input="applyFilters"
            placeholder="Max $"
        />

        <button class="btn btn-secondary" @click="resetFilters">
            Reset
        </button>

        <span class="results-count">{{ resultsCount }} products</span>
    </div>
</template>

<script>
export default {
    name: 'FilterBar',
    props: {
        categories: {
            type: Array,
            default: function() { return []; }
        },
        resultsCount: {
            type: Number,
            default: 0
        }
    },
    data: function() {
        return {
            search: '',
            category: '',
            minPrice: '',
            maxPrice: ''
        };
    },
    emits: ['filter-change', 'filter-reset'],
    methods: {
        applyFilters: function() {
            this.$emit('filter-change', {
                search: this.search,
                category: this.category,
                minPrice: this.minPrice,
                maxPrice: this.maxPrice
            });
        },
        resetFilters: function() {
            this.search = '';
            this.category = '';
            this.minPrice = '';
            this.maxPrice = '';
            this.$emit('filter-reset');
        }
    }
};
</script>

<style scoped>
.filter-bar {
    background: white;
    border-radius: var(--radius);
    padding: 16px 20px;
    box-shadow: var(--shadow);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
}

.filter-bar select,
.filter-bar input {
    padding: 8px 12px;
    border: 1px solid var(--gray-200);
    border-radius: 8px;
    font-size: 14px;
    background: white;
    color: var(--gray-900);
    transition: var(--transition);
}

.filter-bar select:focus,
.filter-bar input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.filter-bar input[type="number"] {
    width: 100px;
}

.filter-bar .search-input {
    flex: 1;
    min-width: 150px;
}

.filter-bar .results-count {
    margin-left: auto;
    font-size: 14px;
    color: var(--gray-500);
}

.btn-secondary {
    background: var(--gray-100);
    color: var(--gray-700);
    padding: 8px 16px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    cursor: pointer;
    transition: var(--transition);
}

.btn-secondary:hover {
    background: var(--gray-200);
}

@media (max-width: 640px) {
    .filter-bar {
        flex-direction: column;
    }
    .filter-bar select,
    .filter-bar input,
    .filter-bar .search-input {
        width: 100%;
    }
    .filter-bar .results-count {
        margin-left: 0;
        text-align: center;
    }
}
</style>