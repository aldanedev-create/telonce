{
  "name": "@teloce/bundler",
  "version": "0.1.0",
   "publishConfig": {
    "access": "public"
  },
  "description": "Teloce bundler - production packaging with tree-shaking, minification, and chunk splitting",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@teloce/compiler": "workspace:^",
    "@teloce/shared": "workspace:^"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "teloce",
    "bundler",
    "tree-shaking",
    "minifier",
    "chunks",
    "production",
    "build",
    "optimization"
  ],
  "author": "Teloce Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aldanedev-create/telonce",
    "directory": "packages/bundler"
  },
  "bugs": {
    "url": "https://github.com/aldanedev-create/telonce/issues"
  },
  "homepage": "https://telonce-website.vercel.app/#/"
}