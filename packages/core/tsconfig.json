{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDeclarationOnly": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "paths": {
      "@teloce/reactivity": ["../reactivity/src"],
      "@teloce/runtime-dom": ["../runtime-dom/src"],
      "@teloce/std": ["../std/src"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../reactivity" },
    { "path": "../runtime-dom" },
    { "path": "../std" }
  ]
}