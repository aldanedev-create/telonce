{
  "name": "@teloce/debugger",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Teloce human-friendly debugger - translates cryptic errors into plain English with local dashboard",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dashboard",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@teloce/compiler": "workspace:^",
    "@teloce/server": "workspace:^",
    "@teloce/shared": "workspace:^"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "teloce",
    "debugger",
    "error-parser",
    "suggestions",
    "analyzer",
    "inspector",
    "dashboard",
    "human-friendly"
  ],
  "author": "Teloce Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aldanedev-create/telonce",
    "directory": "packages/debugger"
  },
  "bugs": {
    "url": "https://github.com/aldanedev-create/telonce/issues"
  },
  "homepage": "https://telonce-website.vercel.app"
}