{
  "name": "@teloce/vite-plugin",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Vite plugin for Teloce - compile .vel Single File Components and templates",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@teloce/compiler": "workspace:^",
    "@teloce/sfc": "workspace:^",
    "@teloce/shared": "workspace:^"
  },
  "peerDependencies": {
    "vite": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "teloce",
    "vite",
    "plugin",
    "template-engine",
    "single-file-component",
    "sfc",
    "vel"
  ],
  "author": "Teloce Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aldanedev-create/telonce",
    "directory": "packages/plugins/vite"
  },
  "bugs": {
    "url": "https://github.com/aldanedev-create/telonce/issues"
  },
  "homepage": "https://telonce-website.vercel.app"
}