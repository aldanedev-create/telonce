{
  "name": "@teloce/router",
  "version": "0.4.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "A small client-side router for Teloce SPAs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/teloce-router.global.js",
  "jsdelivr": "dist/teloce-router.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@teloce/reactivity": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}