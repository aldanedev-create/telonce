{
  "name": "@teloce/sfc",
  "version": "0.1.0",
  "description": "Teloce Single File Component (.vel) compiler - splits template/script/style sections",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@teloce/compiler": "workspace:^",
    "@teloce/shared": "workspace:^"
  },
  "peerDependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "teloce",
    "sfc",
    "single-file-component",
    "template-engine",
    "python",
    "flask",
    "django",
    "fastapi"
  ],
  "author": "Teloce Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/telocejs/teloce.git",
    "directory": "packages/sfc"
  },
  "bugs": {
    "url": "https://github.com/telocejs/teloce/issues"
  },
  "homepage": "https://teloce.dev"
}