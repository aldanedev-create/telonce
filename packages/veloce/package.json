{
  "name": "teloce",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "A TypeScript template engine for Python web developers",
  "main": "dist/teloce.global.js",
  "module": "dist/teloce.esm.js",
  "unpkg": "dist/teloce.global.js",
  "jsdelivr": "dist/teloce.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/teloce.esm.js",
      "require": "./dist/teloce.global.js",
      "default": "./dist/teloce.global.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@teloce/compiler": "workspace:*",
    "@teloce/core": "workspace:*",
    "@teloce/reactivity": "workspace:*",
    "@teloce/runtime-core": "workspace:*",
    "@teloce/runtime-dom": "workspace:*",
    "@teloce/sfc": "workspace:*",
    "@teloce/std": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "teloce",
    "template-engine",
    "python",
    "flask",
    "django",
    "fastapi",
    "signals",
    "reactive",
    "frontend",
    "javascript",
    "typescript"
  ],
  "author": "Teloce Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aldanedev-create/telonce"
  },
  "bugs": {
    "url": "https://github.com/aldanedev-create/telonce/issues"
  },
  "homepage": "https://telonce-website.vercel.app"
}