{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Teloce",
  "scopeName": "source.teloce",
  "patterns": [
    {
      "name": "meta.tag.teloce",
      "begin": "(<)([\\w:-]+)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "name": "meta.attribute.teloce",
          "match": "(@\\w+)(=)(['\"])([^'\"]*)(['\"])",
          "captures": {
            "1": { "name": "entity.other.attribute-name.event.teloce" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.definition.string.begin.html" },
            "4": { "name": "string.quoted.double.html" },
            "5": { "name": "punctuation.definition.string.end.html" }
          }
        },
        {
          "name": "meta.attribute.teloce",
          "match": "(:\\w+)(=)(['\"])([^'\"]*)(['\"])",
          "captures": {
            "1": { "name": "entity.other.attribute-name.binding.teloce" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.definition.string.begin.html" },
            "4": { "name": "string.quoted.double.html" },
            "5": { "name": "punctuation.definition.string.end.html" }
          }
        },
        {
          "name": "meta.attribute.teloce",
          "match": "(\\w+)(=)(['\"])([^'\"]*)(['\"])",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.definition.string.begin.html" },
            "4": { "name": "string.quoted.double.html" },
            "5": { "name": "punctuation.definition.string.end.html" }
          }
        }
      ]
    },
    {
      "name": "meta.interpolation.teloce",
      "begin": "\\{\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.interpolation.begin.teloce" }
      },
      "end": "\\}\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.interpolation.end.teloce" }
      },
      "patterns": [
        {
          "name": "meta.expression.teloce",
          "match": "(\\w+)(\\.\\w+)?",
          "captures": {
            "1": { "name": "variable.other.teloce" },
            "2": { "name": "variable.other.property.teloce" }
          }
        },
        {
          "name": "keyword.operator.filter.teloce",
          "match": "\\|\\s*(\\w+)",
          "captures": {
            "1": { "name": "entity.name.function.filter.teloce" }
          }
        }
      ]
    },
    {
      "name": "meta.directive.teloce",
      "begin": "(<)(for|if|else|show|hide|switch|case)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "keyword.control.directive.teloce" }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        {
          "name": "meta.attribute.teloce",
          "match": "(\\w+)(=)(['\"])([^'\"]*)(['\"])",
          "captures": {
            "1": { "name": "entity.other.attribute-name.directive.teloce" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.definition.string.begin.html" },
            "4": { "name": "string.quoted.double.html" },
            "5": { "name": "punctuation.definition.string.end.html" }
          }
        }
      ]
    },
    {
      "name": "comment.block.documentation.teloce",
      "begin": "/\\*\\*",
      "end": "\\*/",
      "patterns": [
        {
          "name": "meta.tag.teloce",
          "match": "@(param|returns|type|typedef|property)",
          "captures": {
            "1": { "name": "keyword.other.documentation.teloce" }
          }
        },
        {
          "name": "meta.type.teloce",
          "match": "{([^}]+)}",
          "captures": {
            "1": { "name": "entity.name.type.teloce" }
          }
        }
      ]
    }
  ]
}