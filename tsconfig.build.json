{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "noEmit": false,
    "outDir": "./dist"
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".turbo",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/__mocks__/**"
  ]
}